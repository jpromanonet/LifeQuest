APP_NAME=LifeQuest
APP_ENV=local
APP_DEBUG=true
# URL pública de la app, sin barra final. Ej: http://192.168.x.x/lifequest
APP_URL=http://localhost/lifequest

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lifequest
DB_USER=root
# Dejar vacío o completar solo en el .env local / del servidor. Nunca commitear contraseñas.
DB_PASS=

SESSION_NAME=lifequest_session
# Segundos de vida de la cookie (se renueva en cada visita). Mínimo efectivo: 24 h.
SESSION_LIFETIME=86400
# Cerrar sesión solo si no vuelve en este plazo (mínimo 24 h)
SESSION_IDLE=86400
# Con "Recordarme" tildado en el login (30 días)
SESSION_REMEMBER=2592000

# Opcional: sistema externo de finanzas. Dejar vacío para no crear el enlace.
PATRIUM_URL=
