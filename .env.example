APP_NAME=LifeQuest
APP_ENV=local
APP_DEBUG=true
# URL pública de la app, sin barra final. Ej: http://192.168.x.x/lifequest
APP_URL=http://localhost/lifequest

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lifequest
DB_USER=root
# Dejar vacío o completar solo en el .env local / del servidor. Nunca commitear contraseñas.
DB_PASS=

SESSION_NAME=lifequest_session
# Segundos de vida de la cookie de sesión
SESSION_LIFETIME=28800
# Segundos de inactividad antes de cerrar sesión
SESSION_IDLE=7200

# Opcional: sistema externo de finanzas. Dejar vacío para no crear el enlace.
PATRIUM_URL=
